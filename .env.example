# Copy to .env (never commit). All names use the AMRH_ prefix.

# Optional Qwen/MLX TTS on Apple Silicon
# AMRH_QWEN_PYTHON=/opt/homebrew/bin/python3.12
# AMRH_QWEN_BASE_MODEL=/absolute/path/to/Qwen3-TTS-12Hz-0.6B-Base-8bit@REVISION

# Optional worker-cap overrides (integers 1-4 only)
# AMRH_ASR_THREADS=2
# AMRH_ASR_INTEROP_THREADS=1
# AMRH_FFMPEG_THREADS=2
# AMRH_HYPERFRAMES_WORKERS=2

# Optional Baidu Netdisk upload (upload-only; keep tokens out of git)
# AMRH_BAIDU_ACCESS_TOKEN=
# AMRH_BAIDU_REFRESH_TOKEN=
# AMRH_BAIDU_APP_KEY=
# AMRH_BAIDU_SECRET_KEY=
# AMRH_BAIDU_APP_NAME=amrh
# AMRH_BAIDU_CREDENTIALS_FILE=/absolute/outside/repo/baidu-credentials.json
